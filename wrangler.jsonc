{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "re-main",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // アプリ本体（PWA）は静的ファイルとして配信し、/api/ だけ Worker で処理する
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "SCHED", "class_name": "Scheduler" },
      { "name": "KEYS", "class_name": "Keys" }
    ]
  },
  // 無料プランで使えるのは SQLite 版の Durable Object
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scheduler", "Keys"] }],
  "observability": { "enabled": true },
  // main 以外のブランチのプレビュー用。各プレビューは自前の Durable Object を持つので、コードが使うバインディングだけ宣言する
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "SCHED", "class_name": "Scheduler" },
        { "name": "KEYS", "class_name": "Keys" }
      ]
    }
  }
}
